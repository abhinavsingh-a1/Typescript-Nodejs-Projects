# single      = everything in ONE process, no Redis needed (small / self-hosted)
# distributed = API + workers + scheduler as separate processes, Redis queue (scale)
MODE=distributed
PORT=3000

# App user: restricted by Row-Level Security (sees one tenant at a time)
DATABASE_URL=postgres://flowlite_app:flowlite_app@localhost:5433/flowlite
# Admin user: only for migrations
ADMIN_DATABASE_URL=postgres://flowlite:flowlite@localhost:5433/flowlite
REDIS_URL=redis://localhost:6380

# Logs: "pretty" (easy to read) or "json" (for tools / production)
LOG_FORMAT=pretty
LOG_LEVEL=info

# Daily report timer (86400 = once a day)
REPORT_INTERVAL_SECONDS=60

# Hosts the "http" plugin may call (protects against SSRF)
ALLOWED_HTTP_HOSTS=localhost,127.0.0.1
