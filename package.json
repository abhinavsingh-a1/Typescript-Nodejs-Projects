{
  "name": "flowlite",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "scheduler": "tsx src/scheduler.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test:idempotency": "tsx scripts/test-idempotency.ts",
    "test:tenancy": "tsx scripts/test-tenancy.ts",
    "test:saga": "tsx scripts/test-saga.ts",
    "test:crash": "tsx scripts/test-crash.ts",
    "test:cron": "tsx scripts/test-cron.ts",
    "test:observability": "tsx scripts/test-observability.ts",
    "test:plugins": "tsx scripts/test-plugins.ts",
    "test:live": "tsx scripts/test-live.ts",
    "test:single": "tsx scripts/test-single.ts",
    "test:migrations": "tsx scripts/test-migrations.ts",
    "test:all": "npm run test:idempotency && npm run test:tenancy && npm run test:saga && npm run test:crash && npm run test:cron && npm run test:observability && npm run test:plugins && npm run test:live && npm run test:single && npm run test:migrations"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "tsx": "^4.19.1",
    "ws": "^8.18.0"
  },
  "description": "Multi-tenant workflow engine: idempotency, sagas, crash recovery, distributed locks, plugins, live updates. TypeScript + Postgres + Redis.",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.2"
  }
}
